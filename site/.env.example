# Local development only. This file is gitignored — never commit it.
# On Vercel these are set under Project Settings → Environment Variables.

# --- SMTP (quote form delivery) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
# Leave SMTP_SECURE unset: it is derived from the port.
#   465 = implicit TLS, 587 = STARTTLS
# SMTP_SECURE=false

SMTP_USER=you@example.com

# REQUIRED — currently empty, so the form returns HTTP 503.
# Must be a Google App Password, NOT the account password:
#   https://myaccount.google.com/apppasswords  (needs 2-Step Verification)
# 16 characters, paste without spaces.
SMTP_PASS=your-16-char-google-app-password

# Where enquiries are delivered.
SMTP_TO=you@example.com

# From header. Gmail only allows the authenticated mailbox or a verified
# "Send mail as" alias — anything else is rewritten or rejected. If
# SMTP_FROM_EMAIL is missing or invalid the code falls back to SMTP_USER.
SMTP_FROM_NAME=Your Brand Name
SMTP_FROM_EMAIL=you@example.com

# --- Indexability ---
# Only set this to "production" on the real production build. Anywhere else
# the site serves robots.txt "Disallow: /" and noindex,nofollow.
# PUBLIC_SITE_ENV=production
