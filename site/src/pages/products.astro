---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import ProductGrid from '../components/ProductGrid.astro';
import CTASection from '../components/CTASection.astro';
import { products, categories, productsInCategory } from '../lib/catalogue';
import { absoluteUrl } from '../lib/site';

const path = '/products/';
const crumbs = [{ label: 'Home', href: '/' }, { label: 'Products' }];

/*
 * The published /products/ page opened with an Elementor block listing 29
 * burger-box products left over from an earlier site on the same WordPress
 * install, and its Open Graph tags still described that catalogue. None of it
 * exists in the WooCommerce export, so it is excluded and the page now leads
 * with the real sticker range grouped by category.
 * See reports/MIGRATION_CONFLICTS.md.
 */
---

<BaseLayout
  title="All Sticker Products | The Die Cut Stickers"
  description="Browse every custom sticker we print: vinyl, clear, holographic, metallic, reflective, waterproof and eco-friendly options in any shape or size."
  path={path}
  schema={[
    {
      '@context': 'https://schema.org',
      '@type': 'BreadcrumbList',
      itemListElement: crumbs.map((c, i) => ({
        '@type': 'ListItem',
        position: i + 1,
        name: c.label,
        ...(c.href ? { item: absoluteUrl(c.href) } : {}),
      })),
    },
    {
      '@context': 'https://schema.org',
      '@type': 'CollectionPage',
      name: 'All Products',
      url: absoluteUrl(path),
      mainEntity: {
        '@type': 'ItemList',
        numberOfItems: products.length,
        itemListElement: products.map((p, i) => ({
          '@type': 'ListItem',
          position: i + 1,
          name: p.name,
          url: absoluteUrl(`/product/${p.slug}/`),
        })),
      },
    },
  ]}
>
  <Breadcrumbs items={crumbs} />

  <section class="section-tight">
    <div class="container">
      <h1>All Products</h1>
      <p class="lede">
        Every sticker below is printed to your own artwork and cut to shape. Browse the full
        range, or jump to a category to compare materials, finishes and sizes.
      </p>
      <ul class="cat-links" role="list">
        {
          categories.map((c) => (
            <li>
              <a href={`/product-category/${c.slug}/`}>{c.name}</a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  {
    categories.map((c, ci) => {
      const items = productsInCategory(c.slug);
      return (
        items.length > 0 && (
          <section
            class:list={['section-tight', ci % 2 === 0 && 'section-white']}
            aria-labelledby={`cat-${c.slug}`}
          >
            <div class="container">
              <div class="cat-head">
                <h2 id={`cat-${c.slug}`}>{c.name}</h2>
                <a class="cat-more" href={`/product-category/${c.slug}/`}>
                  All {c.name.toLowerCase()} stickers
                </a>
              </div>
              <ProductGrid products={items} eagerCount={ci === 0 ? 3 : 0} />
            </div>
          </section>
        )
      );
    })
  }

  <CTASection id="quote" />
</BaseLayout>

<style>
  .lede {
    max-width: 760px;
    font-size: 1.02rem;
  }
  .cat-links {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    list-style: none;
    margin: 18px 0 0;
    padding: 0;
  }
  .cat-links a {
    display: inline-block;
    padding: 8px 16px;
    border-radius: 999px;
    background: var(--tint);
    color: var(--blue);
    text-decoration: none;
    font-size: 0.9rem;
    font-weight: 600;
  }
  .cat-links a:hover {
    background: var(--purple);
    color: #fff;
  }
  .cat-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 16px;
    flex-wrap: wrap;
    margin-bottom: 20px;
  }
  .cat-head h2 {
    margin: 0;
  }
  .cat-more {
    font-size: 0.9rem;
    font-weight: 600;
  }
</style>
