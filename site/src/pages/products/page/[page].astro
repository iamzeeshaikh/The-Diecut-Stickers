---
// Pages two and up, at /products/page/N/ — preserving the paginated URLs the
// WordPress archive published (page two was live and carried rel="next").
import ProductsArchive from '../../../components/ProductsArchive.astro';
import { productsByName, PRODUCTS_PER_PAGE } from '../../../lib/catalogue';

export function getStaticPaths() {
  const lastPage = Math.ceil(productsByName.length / PRODUCTS_PER_PAGE);
  return Array.from({ length: lastPage - 1 }, (_, i) => ({
    params: { page: String(i + 2) },
    props: { currentPage: i + 2 },
  }));
}

const { currentPage } = Astro.props;
---

<ProductsArchive currentPage={currentPage} />
