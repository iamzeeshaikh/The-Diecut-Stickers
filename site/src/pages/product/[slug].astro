---
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import ProductGallery from '../../components/ProductGallery.astro';
import ProductSpecifications from '../../components/ProductSpecifications.astro';
import FAQSection from '../../components/FAQSection.astro';
import RelatedProducts from '../../components/RelatedProducts.astro';
import InquiryForm from '../../components/InquiryForm.astro';
import QuoteSection from '../../components/QuoteSection.astro';
import QuickAnswer from '../../components/QuickAnswer.astro';
import ContentSections from '../../components/ContentSections.astro';
import { products, getCategory, relatedProducts } from '../../lib/catalogue';
import { resolveImage } from '../../lib/images';
import { absoluteUrl, SITE } from '../../lib/site';
import { FACTS } from '../../lib/facts';
import { legacyRating } from '../../lib/legacy-ratings';
import { productContent } from '../../lib/product-content';
import { categoryMeta } from '../../lib/category-content';

import payments from '../../assets/img/payments.png';
import guarantee from '../../assets/img/guarantee_image.webp';
import fedex from '../../assets/img/fedex-logo.png';

export function getStaticPaths() {
  return products.map((product) => ({ params: { slug: product.slug }, props: { product } }));
}

const { product } = Astro.props;
const category = getCategory(product.categorySlug);
const catMeta = category ? categoryMeta(category.slug) : undefined;
const related = relatedProducts(product, 4);
const path = `/product/${product.slug}/`;

/*
 * Rewritten copy (src/data/product-content) when present; the migrated
 * WordPress record otherwise, so a product never ships blank.
 */
const rewrite = productContent(product.slug);
const name = rewrite?.name ?? product.name;
const title = rewrite?.seoTitle ?? product.seoTitle;
const description = rewrite?.seoDescription ?? product.seoDescription;
const faqs = rewrite?.faqs ?? product.faqs;

const heroImage = resolveImage(product.images[0] ?? '');
const ogImage = heroImage ? heroImage.src : undefined;
const price = Number(product.price) || FACTS.unitPriceFrom;

const crumbs = [
  { label: 'Home', href: '/' },
  { label: 'Stickers', href: '/products/' },
  ...(category && catMeta ? [{ label: catMeta.navLabel, href: `/product-category/${category.slug}/` }] : []),
  { label: name },
];

const legacyDescription = product.description
  .replace(/<table/gi, '<div class="table-scroll"><table')
  .replace(/<\/table>/gi, '</table></div>');

/*
 * Product schema. The aggregateRating and review are the old WordPress page's
 * own, restored verbatim from src/data/legacy-ratings.json. Offer details
 * mirror the site's commitments in src/lib/facts.ts and /refund_returns/.
 */
const schema: Record<string, unknown>[] = [
  {
    '@context': 'https://schema.org',
    '@type': 'Product',
    '@id': absoluteUrl(path) + '#product',
    name,
    sku: product.sku,
    description: rewrite?.quickAnswer ?? description,
    url: absoluteUrl(path),
    brand: { '@type': 'Brand', name: SITE.name },
    category: catMeta?.name ?? category?.name,
    image: product.images
      .map((i) => resolveImage(i))
      .filter((i) => i !== undefined)
      .map((i) => absoluteUrl(i!.src)),
    offers: {
      '@type': 'Offer',
      url: absoluteUrl(path),
      price: price.toFixed(2),
      priceCurrency: 'USD',
      priceValidUntil: '2027-08-04',
      availability: 'https://schema.org/InStock',
      itemCondition: 'https://schema.org/NewCondition',
      seller: { '@id': absoluteUrl('/#organization') },
      shippingDetails: {
        '@type': 'OfferShippingDetails',
        shippingRate: { '@type': 'MonetaryAmount', value: '0.00', currency: 'USD' },
        shippingDestination: { '@type': 'DefinedRegion', addressCountry: 'US' },
        deliveryTime: {
          '@type': 'ShippingDeliveryTime',
          handlingTime: { '@type': 'QuantitativeValue', minValue: 5, maxValue: 7, unitCode: 'DAY' },
          transitTime: { '@type': 'QuantitativeValue', minValue: 2, maxValue: 5, unitCode: 'DAY' },
        },
      },
      hasMerchantReturnPolicy: {
        '@type': 'MerchantReturnPolicy',
        applicableCountry: 'US',
        returnPolicyCategory: 'https://schema.org/MerchantReturnFiniteReturnWindow',
        merchantReturnDays: FACTS.returnsDays,
        returnMethod: 'https://schema.org/ReturnByMail',
        returnFees: 'https://schema.org/FreeReturn',
      },
    },
    ...legacyRating(product.slug),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: crumbs.map((c, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      name: c.label,
      ...(c.href ? { item: absoluteUrl(c.href) } : {}),
    })),
  },
];

if (faqs.length) {
  schema.push({
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  });
}
---

<BaseLayout title={title} description={description} path={path} ogImage={ogImage} ogType="product" schema={schema}>
  <Breadcrumbs items={crumbs} />

  <section class="product-top">
    <div class="container container-wide top-grid">
      <div class="col-gallery">
        <ProductGallery name={name} images={product.images} />
      </div>

      <div class="col-summary">
        <h1>{rewrite?.h1 ?? name}</h1>
        {rewrite?.tagline && <p class="tagline">{rewrite.tagline}</p>}
        {
          rewrite ? (
            <QuickAnswer text={rewrite.quickAnswer} highlights={rewrite.highlights} />
          ) : (
            <div class="rich-text short" set:html={product.shortDescription} />
          )
        }
        <div class="buy-row">
          <p class="price">
            From <strong>${price.toFixed(2)}</strong> per sticker
            <span>Minimum {FACTS.minOrderLabel}. Price falls with quantity and size.</span>
          </p>
          <div class="buy-actions">
            <a class="btn btn-primary btn-lg" href="#product-quote">Get a price</a>
            <a class="btn btn-outline btn-lg" href="/get-a-quote/">Design your custom stickers</a>
          </div>
        </div>
        <ul class="promises">
          <li>{FACTS.proof}</li>
          <li>{FACTS.shipping}</li>
          <li>Production {FACTS.productionDays}, delivered in {FACTS.deliveryDays}</li>
          <li>Gloss, matte or spot UV finish</li>
        </ul>
        <div class="trust">
          <Image src={payments} alt="PayPal, Visa, Mastercard, Apple Pay and Google Pay accepted" height={30} loading="lazy" />
          <Image src={guarantee} alt="100% satisfaction guarantee" height={38} loading="lazy" />
          <Image src={fedex} alt="FedEx delivery" height={26} loading="lazy" />
        </div>
      </div>

      <aside class="col-form card" id="product-quote">
        <InquiryForm variant="compact" id="product-quote-form" selectedProduct={name} heading="Get a quote for these stickers" />
      </aside>
    </div>
  </section>

  <nav class="jump" aria-label="On this page">
    <div class="container container-wide jump-inner">
      <a href="#description">Details</a>
      <a href="#specifications">Specifications</a>
      <a href="#faqs">Questions</a>
      <a href="#related">Related stickers</a>
    </div>
  </nav>

  <section class="section-tight" id="description" aria-labelledby="description-heading">
    <div class="container container-wide body-grid">
      <div class="body-main">
        <h2 id="description-heading" class="visually-hidden">About {name}</h2>
        {rewrite ? <ContentSections sections={rewrite.sections} /> : <div class="rich-text" set:html={legacyDescription} />}
      </div>
      <aside class="body-aside">
        <div class="card aside-card">
          <h3>Specifications</h3>
          {
            rewrite ? (
              <table class="data specs" id="specifications">
                <tbody>
                  {rewrite.specs.map(([k, v]) => (
                    <tr>
                      <th scope="row">{k}</th>
                      <td>{v}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            ) : (
              <div id="specifications">
                <ProductSpecifications html={product.specifications} />
              </div>
            )
          }
        </div>
        <div class="card aside-card aside-help">
          <h3>Not sure this is the right sticker?</h3>
          <p>Tell us the surface, the size and where it lives. We will confirm the material or point you to a better fit before you spend anything.</p>
          <a class="btn btn-outline" href="/contact-us/">Ask a question</a>
        </div>
      </aside>
    </div>
  </section>

  <section class="section-tight section-white">
    <div class="container container-wide">
      <FAQSection faqs={faqs} heading={`${name}: questions buyers ask`} id="faqs" />
    </div>
  </section>

  <div id="related">
    <RelatedProducts products={related} heading={`Other ${catMeta ? catMeta.navLabel.toLowerCase() : 'stickers'} to compare`} />
  </div>

  <QuoteSection selectedProduct={name} id="quote" heading={`Order ${name.toLowerCase()}`} />
</BaseLayout>

<style>
  .product-top {
    background: var(--white);
    border-bottom: 1px solid var(--line);
    padding: 28px 0 36px;
  }
  .top-grid {
    display: grid;
    grid-template-columns: minmax(0, 0.95fr) minmax(0, 1.25fr) minmax(0, 0.8fr);
    gap: 40px;
    align-items: start;
  }
  .col-summary h1 {
    margin-bottom: 8px;
  }
  .tagline {
    font-size: 1.15rem;
    color: var(--muted);
    margin: 0 0 18px;
  }
  .short {
    font-size: 1rem;
  }
  .buy-row {
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
    padding: 16px 0;
    margin: 6px 0 16px;
  }
  .price {
    margin: 0 0 14px;
    font-size: 1.15rem;
    color: var(--ink);
  }
  .price strong {
    font-size: 1.6rem;
    font-family: var(--font-serif);
  }
  .price span {
    display: block;
    font-size: 0.9rem;
    color: var(--muted);
  }
  .buy-actions {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
  }
  .promises {
    list-style: none;
    margin: 0 0 16px;
    padding: 0;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 6px 18px;
    font-size: 0.95rem;
  }
  .promises li {
    padding-left: 22px;
    position: relative;
  }
  .promises li::before {
    content: '';
    position: absolute;
    left: 2px;
    top: 8px;
    width: 10px;
    height: 6px;
    border-left: 2px solid var(--teal);
    border-bottom: 2px solid var(--teal);
    transform: rotate(-45deg);
  }
  .trust {
    display: flex;
    align-items: center;
    gap: 18px;
    flex-wrap: wrap;
  }
  .trust :global(img) {
    width: auto;
    height: auto;
    max-height: 38px;
  }
  .col-form {
    padding: 22px;
    position: sticky;
    top: 92px;
  }

  .jump {
    background: var(--page);
    border-bottom: 1px solid var(--line);
    position: sticky;
    top: 76px;
    z-index: 5;
  }
  .jump-inner {
    display: flex;
    gap: 6px;
    overflow-x: auto;
  }
  .jump a {
    padding: 12px 14px;
    text-decoration: none;
    font-weight: 600;
    font-size: 0.95rem;
    color: var(--muted);
    white-space: nowrap;
    border-bottom: 2px solid transparent;
  }
  .jump a:hover {
    color: var(--teal-dark);
    border-bottom-color: var(--teal);
  }

  .body-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 360px;
    gap: 48px;
    align-items: start;
  }
  .body-main {
    max-width: 78ch;
  }
  .body-aside {
    position: sticky;
    top: 130px;
    display: grid;
    gap: 20px;
  }
  .aside-card {
    padding: 20px;
  }
  .aside-card h3 {
    font-size: 1.15rem;
    margin-bottom: 12px;
  }
  .specs {
    font-size: 0.92rem;
  }
  .specs th {
    width: 38%;
    color: var(--ink);
    font-weight: 600;
    padding-left: 0;
  }
  .specs td {
    padding-right: 0;
  }
  .aside-help p {
    font-size: 0.95rem;
  }

  @media (max-width: 1100px) {
    .top-grid {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    }
    .col-form {
      grid-column: 1 / -1;
      position: static;
      max-width: 560px;
    }
    .body-grid {
      grid-template-columns: minmax(0, 1fr);
    }
    .body-aside {
      position: static;
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    }
    .jump {
      top: 64px;
    }
  }
  @media (max-width: 720px) {
    .top-grid {
      grid-template-columns: minmax(0, 1fr);
      gap: 24px;
    }
    .col-form {
      max-width: none;
    }
    .promises {
      grid-template-columns: minmax(0, 1fr);
    }
    .body-aside {
      grid-template-columns: minmax(0, 1fr);
    }
    .buy-actions .btn {
      flex: 1 1 100%;
    }
  }
</style>
