---
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import ProductGallery from '../../components/ProductGallery.astro';
import ProductSpecifications from '../../components/ProductSpecifications.astro';
import FAQSection from '../../components/FAQSection.astro';
import RelatedProducts from '../../components/RelatedProducts.astro';
import InquiryForm from '../../components/InquiryForm.astro';
import CTASection from '../../components/CTASection.astro';
import { products, getCategory, relatedProducts } from '../../lib/catalogue';
import { resolveImage } from '../../lib/images';
import { absoluteUrl, SITE } from '../../lib/site';

import secure from '../../assets/img/secure-icons.png';
import payments from '../../assets/img/payments.png';
import paymentImage from '../../assets/img/payment-image.jpeg';
import dmca from '../../assets/img/dmca-badge-w250-2x1-01.png';
import guarantee from '../../assets/img/guarantee_image.webp';
import fedex from '../../assets/img/fedex-logo.png';

export function getStaticPaths() {
  return products.map((product) => ({ params: { slug: product.slug }, props: { product } }));
}

const { product } = Astro.props;
const category = getCategory(product.categorySlug);
const related = relatedProducts(product, 4);
const path = `/product/${product.slug}/`;

const heroImage = resolveImage(product.images[0] ?? '');
const ogImage = heroImage ? heroImage.src : undefined;

const crumbs = [
  { label: 'Home', href: '/' },
  { label: 'Products', href: '/products/' },
  ...(category ? [{ label: category.name, href: `/product-category/${category.slug}/` }] : []),
  { label: product.name },
];

// Wide specification tables scroll inside their own container.
const descriptionHtml = product.description
  .replace(/<table/gi, '<div class="table-scroll"><table')
  .replace(/<\/table>/gi, '</table></div>');

/*
 * Product schema is built only from data that actually exists in the source
 * records. The compromised site emitted an AggregateRating and a Review that
 * were generated by a plugin (single 5-star review authored by an admin email,
 * on products with reviews disabled) plus a price of "0". None of that is
 * carried over. See reports/MIGRATION_CONFLICTS.md.
 */
const schema: Record<string, unknown>[] = [
  {
    '@context': 'https://schema.org',
    '@type': 'Product',
    '@id': absoluteUrl(path) + '#product',
    name: product.name,
    sku: product.sku,
    description: product.seoDescription,
    url: absoluteUrl(path),
    brand: { '@type': 'Brand', name: SITE.name },
    category: category?.name,
    image: product.images
      .map((i) => resolveImage(i))
      .filter((i) => i !== undefined)
      .map((i) => absoluteUrl(i!.src)),
    ...(product.price
      ? {
          offers: {
            '@type': 'Offer',
            url: absoluteUrl(path),
            price: Number(product.price).toFixed(2),
            priceCurrency: 'USD',
            availability: 'https://schema.org/InStock',
            seller: { '@id': absoluteUrl('/#organization') },
          },
        }
      : {}),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: crumbs.map((c, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      name: c.label,
      ...(c.href ? { item: absoluteUrl(c.href) } : {}),
    })),
  },
];

if (product.faqs.length) {
  schema.push({
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: product.faqs.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  });
}
---

<BaseLayout
  title={product.seoTitle}
  description={product.seoDescription}
  path={path}
  ogImage={ogImage}
  ogType="product"
  schema={schema}
>
  <Breadcrumbs items={crumbs} />

  <div class="container container-wide product-head">
    <h1>{product.name}</h1>
  </div>

  <div class="container container-wide product-top">
    <div class="col-gallery">
      <ProductGallery name={product.name} images={product.images} />
      <a class="btn btn-primary quote-cta" href="#quote">Request a quote</a>
    </div>

    <div class="col-summary">
      <div class="rich-text short" set:html={product.shortDescription} />
      {product.price && (
        <p class="price">
          From <strong>${Number(product.price).toFixed(2)}</strong> per sticker
        </p>
      )}
      <div class="trust">
        <Image src={secure} alt="Secure and DMCA protected ordering" height={54} loading="lazy" />
        <Image src={payments} alt="PayPal and secure card payments accepted" height={54} loading="lazy" />
        <Image src={paymentImage} alt="Visa, Mastercard, JCB, Apple Pay and Google Pay accepted" height={54} loading="lazy" />
        <Image src={dmca} alt="DMCA protected" height={54} loading="lazy" />
        <Image src={guarantee} alt="100% satisfaction guarantee" height={54} loading="lazy" />
        <Image src={fedex} alt="FedEx delivery" height={54} loading="lazy" />
      </div>
    </div>

    <div class="col-form">
      <InquiryForm
        variant="compact"
        id="product-quote"
        selectedProduct={product.name}
        heading="Get an instant quote"
      />
    </div>
  </div>

  <div class="container container-wide tabs-wrap">
    <div class="tabs" role="tablist" aria-label="Product information">
      <a class="tab" href="#description" role="tab">Description</a>
      <a class="tab" href="#specifications" role="tab">Specifications</a>
      <a class="tab" href="#faqs" role="tab">Faqs</a>
    </div>
  </div>

  <section class="section-tight" id="description" aria-labelledby="description-heading">
    <div class="container container-wide">
      <h2 id="description-heading" class="visually-hidden">Description</h2>
      <div class="rich-text" set:html={descriptionHtml} />
    </div>
  </section>

  {
    product.specifications && (
      <section class="section-tight section-white" id="specifications" aria-labelledby="specs-heading">
        <div class="container container-wide">
          <h2 id="specs-heading">Specifications</h2>
          <ProductSpecifications html={product.specifications} />
        </div>
      </section>
    )
  }

  {
    product.faqs.length > 0 && (
      <section class="section-tight" id="faqs" aria-labelledby="faqs-heading">
        <div class="container container-wide">
          <h2 id="faqs-heading">Frequently asked questions</h2>
          <FAQSection faqs={product.faqs} />
        </div>
      </section>
    )
  }

  <RelatedProducts products={related} />

  <CTASection selectedProduct={product.name} id="quote" />
</BaseLayout>

<style>
  .product-head {
    padding-top: 32px;
  }
  .product-head h1 {
    margin-bottom: 20px;
  }
  /*
   * Column widths measured from the published product page at a 1348px
   * viewport: gallery 424px, summary 483px, quote form 279px, ~55px gaps.
   */
  .product-top {
    display: grid;
    grid-template-columns: minmax(0, 424fr) minmax(0, 483fr) minmax(0, 279fr);
    gap: 55px;
    align-items: start;
    padding-bottom: 36px;
  }
  .quote-cta {
    display: inline-block;
    margin-top: 18px;
  }
  .short {
    font-size: 0.98rem;
  }
  .price {
    font-size: 1.05rem;
    color: var(--ink);
  }
  .trust {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 14px;
    align-items: center;
    margin-top: 22px;
  }
  .trust :global(img) {
    width: 100%;
    height: auto;
    max-height: 54px;
    object-fit: contain;
  }

  .tabs-wrap {
    border-bottom: 1px solid var(--line);
  }
  .tabs {
    display: flex;
    gap: 28px;
    justify-content: center;
    flex-wrap: wrap;
  }
  .tab {
    padding: 12px 4px;
    color: var(--muted);
    text-decoration: none;
    font-weight: 600;
    font-size: 0.95rem;
    border-bottom: 2px solid transparent;
    min-height: 44px;
  }
  .tab:hover {
    color: var(--purple-dark);
    border-bottom-color: var(--purple);
  }

  @media (max-width: 1040px) {
    .product-top {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    }
    .col-form {
      grid-column: 1 / -1;
      max-width: 520px;
    }
  }
  @media (max-width: 700px) {
    .product-top {
      grid-template-columns: minmax(0, 1fr);
    }
    .col-form {
      max-width: none;
    }
  }
</style>
