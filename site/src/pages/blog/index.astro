---
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import QuoteSection from '../../components/QuoteSection.astro';
import FAQSection from '../../components/FAQSection.astro';
import blogFaqs from '../../data/page-faqs/blog.json';
import { BLOG_POSTS, formatPostDate } from '../../lib/blog';
import { absoluteUrl, SITE } from '../../lib/site';

const path = '/blog/';
const crumbs = [{ label: 'Home', href: '/' }, { label: 'Blog' }];
---

<BaseLayout
  title="Sticker Printing Guides: Materials, Finishes, Sizes and Lifespan"
  description="Guides on sticker materials, outdoor durability, matte and gloss finishes, die cut shapes and sizing, written for brands ordering custom stickers."
  path={path}
  schema={[
    {
      '@context': 'https://schema.org',
      '@type': 'BreadcrumbList',
      itemListElement: crumbs.map((c, i) => ({
        '@type': 'ListItem',
        position: i + 1,
        name: c.label,
        ...(c.href ? { item: absoluteUrl(c.href) } : {}),
      })),
    },
    {
      '@context': 'https://schema.org',
      '@type': 'Blog',
      '@id': absoluteUrl('/blog/#blog'),
      name: `${SITE.name} Blog`,
      url: absoluteUrl('/blog/'),
      publisher: { '@id': absoluteUrl('/#organization') },
      blogPost: BLOG_POSTS.map((p) => ({
        '@type': 'BlogPosting',
        headline: p.title,
        url: absoluteUrl(p.url),
        datePublished: p.date,
      })),
    },
    {
      '@context': 'https://schema.org',
      '@type': 'FAQPage',
      mainEntity: blogFaqs.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
  ]}
>
  <Breadcrumbs items={crumbs} />

  <section class="section-tight">
    <div class="container">
      <h1>Sticker Printing Blog</h1>
      <p class="lead">
        Straight answers on the questions that come up before an order goes to
        press: which material survives a winter outdoors, what matte really
        costs you in color depth, where a decal stops being a label, and how
        big a sticker has to be before people actually read it.
      </p>

      <div class="post-grid">
        {
          BLOG_POSTS.map((post, i) => (
            <article class="post-card">
              <a class="thumb" href={post.url} tabindex="-1" aria-hidden="true">
                <Image
                  src={post.hero}
                  alt=""
                  widths={[320, 640]}
                  sizes="(max-width: 700px) 100vw, 360px"
                  loading={i < 2 ? 'eager' : 'lazy'}
                  decoding="async"
                />
              </a>
              <div class="card-body">
                <p class="date">
                  <time datetime={post.date}>{formatPostDate(post.date)}</time>
                </p>
                <h2><a href={post.url}>{post.title}</a></h2>
                <p class="excerpt">{post.excerpt}</p>
                <a class="more" href={post.url}>
                  Read the guide <span aria-hidden="true">›</span>
                </a>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section-tight section-white">
    <div class="container">
      <FAQSection faqs={blogFaqs} heading="About these guides" />
    </div>
  </section>

  <QuoteSection id="quote" />
</BaseLayout>

<style>
  .lead {
    max-width: 68ch;
    color: var(--muted);
    font-size: 1.05rem;
    line-height: 1.7;
    margin: 0 0 32px;
  }

  .post-grid {
    display: grid;
    /* minmax(0, 1fr) so a long unbroken title cannot blow out the track. */
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 320px), 1fr));
    gap: 28px;
  }

  .post-card {
    display: flex;
    flex-direction: column;
    background: var(--white);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    overflow: hidden;
    }
  .post-card:hover {
    box-shadow: var(--shadow);
  }

  .thumb {
    display: block;
    line-height: 0;
    background: var(--tint);
  }
  .thumb :global(img) {
    width: 100%;
    height: 200px;
    object-fit: cover;
  }

  .card-body {
    display: flex;
    flex-direction: column;
    flex: 1 1 auto;
    padding: 18px 20px 22px;
  }
  .date {
    margin: 0 0 8px;
    font-size: 0.8rem;
    color: var(--muted);
  }
  .card-body h2 {
    font-size: 1.12rem;
    line-height: 1.4;
    margin: 0 0 10px;
  }
  .card-body h2 a {
    color: var(--ink);
    text-decoration: none;
  }
  .card-body h2 a:hover {
    color: var(--purple-dark);
    text-decoration: underline;
  }
  .excerpt {
    margin: 0 0 16px;
    font-size: 0.94rem;
    line-height: 1.65;
    color: var(--muted);
  }
  .more {
    margin-top: auto;
    align-self: flex-start;
    font-weight: 600;
    font-size: 0.92rem;
    color: var(--purple-dark);
    text-decoration: none;
    padding: 4px 0;
  }
  .more:hover {
    text-decoration: underline;
  }
</style>
