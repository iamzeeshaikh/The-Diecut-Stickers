---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import ProductGrid from '../../components/ProductGrid.astro';
import QuoteSection from '../../components/QuoteSection.astro';
import QuickAnswer from '../../components/QuickAnswer.astro';
import ContentSections from '../../components/ContentSections.astro';
import FAQSection from '../../components/FAQSection.astro';
import { categories, productsInCategory } from '../../lib/catalogue';
import { categoryMeta } from '../../lib/category-content';
import { displayName, productContent } from '../../lib/product-content';
import { resolveImage } from '../../lib/images';
import { absoluteUrl, SITE } from '../../lib/site';
import { FACTS } from '../../lib/facts';
import { legacyRating } from '../../lib/legacy-ratings';

export function getStaticPaths() {
  return categories.map((category) => ({ params: { slug: category.slug }, props: { category } }));
}

const { category } = Astro.props;
const content = categoryMeta(category.slug);
const items = productsInCategory(category.slug);
const path = `/product-category/${category.slug}/`;
const others = categories.filter((c) => c.slug !== category.slug).map((c) => categoryMeta(c.slug));

const crumbs = [
  { label: 'Home', href: '/' },
  { label: 'Stickers', href: '/products/' },
  { label: content.navLabel },
];

const first = items[0] ? resolveImage(items[0].images[0] ?? '') : undefined;

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: crumbs.map((c, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      name: c.label,
      ...(c.href ? { item: absoluteUrl(c.href) } : {}),
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: content.name,
    description: content.seoDescription,
    url: absoluteUrl(path),
    mainEntity: {
      '@type': 'ItemList',
      numberOfItems: items.length,
      // The WordPress archive listed each product as a Product node carrying
      // its rating; products with a restored rating are listed the same way.
      itemListElement: items.map((p, i) => {
        const rating = legacyRating(p.slug);
        const url = absoluteUrl(`/product/${p.slug}/`);
        const name = displayName(p);
        if (!rating.aggregateRating) return { '@type': 'ListItem', position: i + 1, name, url };
        return {
          '@type': 'ListItem',
          position: i + 1,
          item: {
            '@type': 'Product',
            name,
            url,
            sku: p.sku,
            description: productContent(p.slug)?.quickAnswer ?? p.seoDescription,
            brand: { '@type': 'Brand', name: SITE.name },
            offers: {
              '@type': 'Offer',
              url,
              price: (Number(p.price) || FACTS.unitPriceFrom).toFixed(2),
              priceCurrency: 'USD',
              availability: 'https://schema.org/InStock',
            },
            ...rating,
          },
        };
      }),
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: content.faqs.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  },
];
---

<BaseLayout title={content.seoTitle} description={content.seoDescription} path={path} ogImage={first?.src} schema={schema}>
  <Breadcrumbs items={crumbs} />

  <section class="cat-head section-white">
    <div class="container">
      <h1>{content.h1}</h1>
      <p class="tagline">{content.tagline}</p>
      <QuickAnswer text={content.quickAnswer} />
      <nav class="cat-switch" aria-label="Other ways to browse">
        <span>Also browse by</span>
        {others.map((o) => <a href={`/product-category/${o.slug}/`}>{o.navLabel}</a>)}
      </nav>
    </div>
  </section>

  <section class="section-tight" aria-labelledby="cat-listing">
    <div class="container">
      <h2 id="cat-listing" class="listing-title">
        {items.length} {content.navLabel.toLowerCase()} products
      </h2>
      <ProductGrid products={items} eagerCount={3} />
    </div>
  </section>

  <section class="section section-white">
    <div class="container guide-grid">
      <div class="guide-main">
        <ContentSections sections={content.sections} />
      </div>
      <aside class="guide-aside">
        <div class="card aside-card">
          <h3>Every sticker here includes</h3>
          <ul>
            <li>{FACTS.proof}</li>
            <li>{FACTS.design}</li>
            <li>{FACTS.shipping}</li>
            <li>Production {FACTS.productionDays}</li>
            <li>Gloss, matte or spot UV finish</li>
            <li>Minimum {FACTS.minOrderLabel}, from {FACTS.unitPriceFromLabel} each</li>
          </ul>
          <a class="btn btn-primary" href="/get-a-quote/">Design your custom stickers</a>
        </div>
      </aside>
    </div>
  </section>

  <section class="section-tight">
    <div class="container">
      <FAQSection faqs={content.faqs} heading={`${content.name}: questions buyers ask`} />
    </div>
  </section>

  <QuoteSection id="quote" heading={`Get a price on ${content.navLabel.toLowerCase()}`} />
</BaseLayout>

<style>
  .cat-head {
    padding: 36px 0 28px;
    border-bottom: 1px solid var(--line);
  }
  .cat-head h1 {
    margin-bottom: 8px;
  }
  .tagline {
    font-size: 1.15rem;
    color: var(--muted);
    max-width: 64ch;
    margin: 0 0 18px;
  }
  .cat-switch {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    align-items: center;
    font-size: 0.92rem;
  }
  .cat-switch span {
    color: var(--muted);
    margin-right: 4px;
  }
  .cat-switch a {
    text-decoration: none;
    border: 1px solid var(--line-strong);
    border-radius: var(--radius);
    padding: 5px 11px;
    color: var(--ink);
  }
  .cat-switch a:hover {
    border-color: var(--teal);
    color: var(--teal-dark);
  }
  .listing-title {
    font-size: 1.25rem;
    margin-bottom: 20px;
  }
  .guide-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 340px;
    gap: 48px;
    align-items: start;
  }
  .guide-main {
    max-width: 78ch;
  }
  .guide-aside {
    position: sticky;
    top: 100px;
  }
  .aside-card {
    padding: 22px;
  }
  .aside-card h3 {
    font-size: 1.1rem;
  }
  .aside-card ul {
    padding-left: 1.2em;
    font-size: 0.95rem;
    margin-bottom: 18px;
  }
  .aside-card li {
    margin-bottom: 6px;
  }
  .aside-card .btn {
    width: 100%;
  }
  @media (max-width: 960px) {
    .guide-grid {
      grid-template-columns: minmax(0, 1fr);
      gap: 28px;
    }
    .guide-aside {
      position: static;
    }
  }
</style>
