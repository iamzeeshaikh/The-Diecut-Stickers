---
import SEOHead from '../components/SEOHead.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { SITE, absoluteUrl } from '../lib/site';
import '../styles/global.css';

import WhatsAppButton from '../components/WhatsAppButton.astro';
interface Props {
  title: string;
  description: string;
  path: string;
  ogImage?: string;
  ogType?: 'website' | 'article' | 'product';
  noindex?: boolean;
  schema?: unknown[];
  prev?: string;
  next?: string;
}

const { title, description, path, ogImage, ogType, noindex, schema = [], prev, next } =
  Astro.props;

// Organization and WebSite are emitted once per page, from real site data only.
const baseSchema = [
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    '@id': absoluteUrl('/#organization'),
    name: SITE.name,
    url: absoluteUrl('/'),
    email: SITE.email,
    telephone: SITE.phone,
    address: {
      '@type': 'PostalAddress',
      streetAddress: SITE.address.street,
      addressLocality: SITE.address.locality,
      addressRegion: SITE.address.region,
      postalCode: SITE.address.postalCode,
      addressCountry: SITE.address.country,
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    '@id': absoluteUrl('/#website'),
    name: SITE.name,
    url: absoluteUrl('/'),
    publisher: { '@id': absoluteUrl('/#organization') },
  },
];
---

<!doctype html>
<html lang="en">
  <head>
    <SEOHead
      title={title}
      description={description}
      path={path}
      ogImage={ogImage}
      ogType={ogType}
      noindex={noindex}
      prev={prev}
      next={next}
      schema={[...baseSchema, ...schema]}
    />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <SiteHeader />
    <main id="main">
      <slot />
    </main>
    <SiteFooter />
    {/* ZeeOps live chat. The widget and its site-config request used to run on
        every page load; they now wait for the visitor's first interaction, or
        6s after load for visitors who never interact, so they never compete
        with the page's own LCP. Bundled rather than inline so the strict CSP
        (script-src 'self' + chat.zeeops.dev) still covers it. Conversations
        land in the dashboard at chat.zeeops.dev under the `thediecutstickers` site. */}
    <script>
      const events = ['pointerdown', 'keydown', 'touchstart', 'scroll'];
      let loaded = false;
      const load = () => {
        if (loaded) return;
        loaded = true;
        for (const ev of events) window.removeEventListener(ev, load);
        const s = document.createElement('script');
        s.src = 'https://chat.zeeops.dev/widget.js?siteId=thediecutstickers';
        s.async = true;
        document.body.appendChild(s);
      };
      for (const ev of events) window.addEventListener(ev, load, { passive: true, once: true });
      addEventListener('load', () => setTimeout(load, 6000));
    </script>
      <WhatsAppButton />
  </body>
</html>
