---
import SEOHead from '../components/SEOHead.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { SITE, absoluteUrl } from '../lib/site';
import '../styles/global.css';

import WhatsAppButton from '../components/WhatsAppButton.astro';
interface Props {
  title: string;
  description: string;
  path: string;
  ogImage?: string;
  ogType?: 'website' | 'article' | 'product';
  noindex?: boolean;
  schema?: unknown[];
  prev?: string;
  next?: string;
}

const { title, description, path, ogImage, ogType, noindex, schema = [], prev, next } =
  Astro.props;

// Organization and WebSite are emitted once per page, from real site data only.
const baseSchema = [
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    '@id': absoluteUrl('/#organization'),
    name: SITE.name,
    url: absoluteUrl('/'),
    email: SITE.email,
    telephone: SITE.phone,
    address: {
      '@type': 'PostalAddress',
      streetAddress: SITE.address.street,
      addressLocality: SITE.address.locality,
      addressRegion: SITE.address.region,
      postalCode: SITE.address.postalCode,
      addressCountry: SITE.address.country,
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    '@id': absoluteUrl('/#website'),
    name: SITE.name,
    url: absoluteUrl('/'),
    publisher: { '@id': absoluteUrl('/#organization') },
  },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta name="google-site-verification" content="IwWG0-c-2GzZOd9jmlphgPO780X6BqOKqzok-JAXCDI" />
    <SEOHead
      title={title}
      description={description}
      path={path}
      ogImage={ogImage}
      ogType={ogType}
      noindex={noindex}
      prev={prev}
      next={next}
      schema={[...baseSchema, ...schema]}
    />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <SiteHeader />
    <main id="main">
      <slot />
    </main>
    <SiteFooter />
    {/* ZeeOps live chat, deferred to the first interaction (or 6s after load)
        so its 23KB and its site-config request never compete with the page's
        own LCP. See public/chat-loader.js. Conversations land in the dashboard
        at chat.zeeops.dev under the `thediecutstickers` site. */}
    <script src="/chat-loader.js" defer></script>
      <WhatsAppButton />
  </body>
</html>
