---
/**
 * Renders an HTTP 410 Gone response for URLs that were created by the
 * WordPress compromise. These were indexed while the site was infected, so a
 * 410 tells search engines the removal is permanent rather than temporary.
 *
 * They are deliberately NOT redirected anywhere: pointing spam URLs at
 * commercial pages would pass their signals into the clean site.
 */
import BaseLayout from '../layouts/BaseLayout.astro';

Astro.response.status = 410;
Astro.response.statusText = 'Gone';
Astro.response.headers.set('cache-control', 'public, max-age=3600');
Astro.response.headers.set('x-robots-tag', 'noindex, nofollow');
---

<BaseLayout
  title="Page removed | The Die Cut Stickers"
  description="This page has been permanently removed."
  path="/410/"
  noindex
>
  <section class="section">
    <div class="container narrow">
      <p class="code">410</p>
      <h1>This page has been permanently removed</h1>
      <p>
        The address you followed pointed at content that was never part of this website. It has
        been deleted and will not return.
      </p>
      <p>
        <a class="btn btn-primary" href="/">Go to the homepage</a>
      </p>
    </div>
  </section>
</BaseLayout>

<style>
  .narrow {
    max-width: 720px;
  }
  .code {
    font-size: 3.4rem;
    font-weight: 800;
    color: var(--purple);
    margin: 0;
    line-height: 1;
  }
</style>
