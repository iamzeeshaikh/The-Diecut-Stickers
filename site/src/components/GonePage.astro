---
/**
 * Renders an HTTP 410 Gone response for URLs that were created by the
 * WordPress compromise. These were indexed while the site was infected, so a
 * 410 tells search engines the removal is permanent rather than temporary.
 *
 * They are deliberately NOT redirected anywhere: pointing spam URLs at
 * commercial pages would pass their signals into the clean site.
 *
 * For on-demand routes only — the status set here is what makes it a 410.
 * Prerendered pages render GoneBody directly and take their status from the
 * Vercel route that serves them.
 */
import GoneBody from './GoneBody.astro';

Astro.response.status = 410;
Astro.response.statusText = 'Gone';
Astro.response.headers.set('cache-control', 'public, max-age=3600');
Astro.response.headers.set('x-robots-tag', 'noindex, nofollow');
---

<GoneBody />
