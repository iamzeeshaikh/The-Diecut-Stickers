---
import { SITE } from '../lib/site';
import { categories } from '../lib/catalogue';

interface Props {
  items: { label: string; href: string }[];
}
const { items } = Astro.props;

// The offcanvas menu exposes every category, not just the three in the desktop bar.
const allCategories = categories.map((c) => ({
  label: c.name,
  href: `/product-category/${c.slug}/`,
}));
const extra = allCategories.filter((c) => !items.some((i) => i.href === c.href));
const current = Astro.url.pathname;
---

<button
  type="button"
  class="menu-toggle"
  id="menu-toggle"
  aria-expanded="false"
  aria-controls="mobile-menu"
>
  <span class="bars" aria-hidden="true"><span></span><span></span><span></span></span>
  <span class="visually-hidden">Open menu</span>
</button>

<div class="menu-backdrop" id="menu-backdrop" hidden></div>

<nav class="mobile-menu" id="mobile-menu" aria-label="Mobile" hidden>
  <div class="mobile-head">
    <span class="mobile-title">Menu</span>
    <button type="button" class="menu-close" id="menu-close">
      <span aria-hidden="true">×</span><span class="visually-hidden">Close menu</span>
    </button>
  </div>
  <ul>
    {
      [...items, ...extra].map((item) => (
        <li>
          <a href={item.href} aria-current={current === item.href ? 'page' : undefined}>
            {item.label}
          </a>
        </li>
      ))
    }
  </ul>
  <div class="mobile-contact">
    <a href={`tel:${SITE.phoneHref}`} class="btn btn-primary">{SITE.phoneDisplay}</a>
    <a href={`mailto:${SITE.email}`}>{SITE.email}</a>
  </div>
</nav>

<style>
  .menu-toggle,
  .menu-close {
    display: none;
    background: transparent;
    border: 0;
    cursor: pointer;
    padding: 12px 10px;
    min-width: 44px;
    min-height: 44px;
    color: var(--ink);
  }
  .bars {
    display: grid;
    gap: 5px;
  }
  .bars span {
    display: block;
    width: 26px;
    height: 3px;
    border-radius: 2px;
    background: var(--ink);
  }

  .menu-backdrop {
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.45);
    z-index: 60;
  }

  .mobile-menu {
    position: fixed;
    top: 0;
    right: 0;
    width: min(320px, 86vw);
    height: 100dvh;
    background: #fff;
    z-index: 70;
    padding: 18px 20px 28px;
    overflow-y: auto;
    box-shadow: -6px 0 24px rgba(0, 0, 0, 0.14);
  }
  .mobile-menu[hidden],
  .menu-backdrop[hidden] {
    display: none;
  }
  .mobile-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    border-bottom: 1px solid var(--line);
    padding-bottom: 12px;
    margin-bottom: 8px;
  }
  .mobile-title {
    font-weight: 700;
    color: var(--ink);
  }
  .menu-close {
    display: block;
    font-size: 1.9rem;
    line-height: 1;
  }
  .mobile-menu ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .mobile-menu li + li {
    border-top: 1px solid var(--line);
  }
  .mobile-menu a {
    display: block;
    padding: 13px 2px;
    color: var(--ink);
    text-decoration: none;
    font-weight: 600;
    min-height: 44px;
  }
  .mobile-menu a[aria-current='page'] {
    color: var(--purple-dark);
  }
  .mobile-contact {
    margin-top: 22px;
    display: grid;
    gap: 12px;
    justify-items: start;
  }

  @media (max-width: 960px) {
    .menu-toggle {
      display: block;
    }
  }
</style>

<script>
  const toggle = document.getElementById('menu-toggle');
  const menu = document.getElementById('mobile-menu');
  const backdrop = document.getElementById('menu-backdrop');
  const close = document.getElementById('menu-close');

  if (toggle && menu && backdrop && close) {
    const focusable = () =>
      menu.querySelectorAll<HTMLElement>('a[href], button:not([disabled])');

    const setOpen = (open: boolean) => {
      menu.hidden = !open;
      backdrop.hidden = !open;
      toggle.setAttribute('aria-expanded', String(open));
      document.body.style.overflow = open ? 'hidden' : '';
      if (open) focusable()[0]?.focus();
      else toggle.focus();
    };

    toggle.addEventListener('click', () => setOpen(menu.hidden === true));
    close.addEventListener('click', () => setOpen(false));
    backdrop.addEventListener('click', () => setOpen(false));

    document.addEventListener('keydown', (e) => {
      if (menu.hidden) return;
      if (e.key === 'Escape') setOpen(false);
      if (e.key === 'Tab') {
        // Keep keyboard focus inside the open drawer.
        const items = Array.from(focusable());
        if (!items.length) return;
        const first = items[0];
        const last = items[items.length - 1];
        if (e.shiftKey && document.activeElement === first) {
          e.preventDefault();
          last.focus();
        } else if (!e.shiftKey && document.activeElement === last) {
          e.preventDefault();
          first.focus();
        }
      }
    });
  }
</script>
