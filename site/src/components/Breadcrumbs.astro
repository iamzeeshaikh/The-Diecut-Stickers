---
interface Crumb {
  label: string;
  href?: string;
}
interface Props {
  items: Crumb[];
}
const { items } = Astro.props;
---

<nav class="breadcrumbs" aria-label="Breadcrumb">
  <div class="container">
    <ol>
      {
        items.map((c, i) => (
          <li>
            {c.href && i < items.length - 1 ? (
              <a href={c.href}>{c.label}</a>
            ) : (
              <span aria-current="page">{c.label}</span>
            )}
            {i < items.length - 1 && <span class="sep" aria-hidden="true">›</span>}
          </li>
        ))
      }
    </ol>
  </div>
</nav>

<style>
  .breadcrumbs {
    background: var(--white);
    border-bottom: 1px solid var(--line);
    font-size: 0.85rem;
  }
  ol {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px;
    list-style: none;
    margin: 0;
    padding: 6px 0;
  }
  li {
    display: flex;
    align-items: center;
    gap: 6px;
  }
  a {
    color: var(--muted);
    text-decoration: none;
    /* Meets the 24px minimum target size. */
    display: inline-block;
    padding: 6px 0;
  }
  a:hover {
    color: var(--purple-dark);
    text-decoration: underline;
  }
  [aria-current='page'] {
    color: var(--ink);
    font-weight: 600;
  }
  .sep {
    color: #b6bdc8;
  }
</style>
