---
import { Image, getImage } from 'astro:assets';
import { resolveImage, productAlt } from '../lib/images';

interface Props {
  name: string;
  images: string[];
}
const { name, images } = Astro.props;

const resolved = images
  .map((ref, i) => ({ img: resolveImage(ref), alt: productAlt(name, i, images.length) }))
  .filter((r): r is { img: NonNullable<ReturnType<typeof resolveImage>>; alt: string } =>
    r.img !== undefined,
  );
const main = resolved[0];

/*
 * Full-size renditions for every gallery image, generated once at build time
 * with the exact widths/sizes the main <Image> uses. Thumbnail buttons carry
 * them as data attributes so a click swaps the main image to the SAME quality
 * it renders at on load — never the 80/160px thumbnail files.
 */
const MAIN_SIZES = '(max-width: 760px) 92vw, 420px';
const fullSize = await Promise.all(
  resolved.map((r) =>
    getImage({ src: r.img, widths: [400, 600, 800], sizes: MAIN_SIZES }),
  ),
);
---

{
  main && (
    <div class="gallery">
      <div class="main-image">
        <Image
          id="gallery-main"
          src={main.img}
          alt={main.alt}
          widths={[400, 600, 800]}
          sizes={MAIN_SIZES}
          loading="eager"
          fetchpriority="high"
          decoding="async"
        />
      </div>

      {resolved.length > 1 && (
        <ul class="thumbs" role="list">
          {resolved.map((r, i) => (
            <li>
              <button
                type="button"
                class:list={['thumb', i === 0 && 'active']}
                data-index={i}
                data-src={fullSize[i].src}
                data-srcset={fullSize[i].srcSet.attribute}
                data-alt={r.alt}
                aria-label={`View image ${i + 1} of ${resolved.length}`}
                aria-pressed={i === 0 ? 'true' : 'false'}
              >
                <Image
                  src={r.img}
                  alt={`${name} image ${i + 1}`}
                  widths={[80, 160]}
                  sizes="72px"
                  width={72}
                  height={72}
                  loading="lazy"
                  decoding="async"
                />
              </button>
            </li>
          ))}
        </ul>
      )}
    </div>
  )
}

<script>
  const root = document.querySelector('.gallery');
  const main = document.getElementById('gallery-main') as HTMLImageElement | null;
  if (root && main) {
    const buttons = Array.from(root.querySelectorAll<HTMLButtonElement>('.thumb'));

    // Warm a full-size rendition so the swap is instant when clicked.
    const warmed = new Set<string>();
    const warm = (btn: HTMLButtonElement) => {
      const src = btn.dataset.src;
      if (!src || warmed.has(src)) return;
      warmed.add(src);
      const img = new Image();
      img.fetchPriority = 'low';
      if (btn.dataset.srcset) {
        img.sizes = main.sizes || '';
        img.srcset = btn.dataset.srcset;
      }
      img.src = src;
    };
    const warmAll = () => buttons.forEach(warm);
    if ('requestIdleCallback' in window) {
      requestIdleCallback(warmAll, { timeout: 3000 });
    } else {
      window.addEventListener('load', () => setTimeout(warmAll, 400), { once: true });
    }

    buttons.forEach((btn) => {
      btn.addEventListener('pointerenter', () => warm(btn));
      btn.addEventListener('touchstart', () => warm(btn), { passive: true });
      btn.addEventListener('click', () => {
        const src = btn.dataset.src;
        if (!src) return;
        // srcset must be swapped before src or the browser keeps the old candidate.
        main.srcset = btn.dataset.srcset || '';
        main.src = src;
        if (btn.dataset.alt) main.alt = btn.dataset.alt;
        buttons.forEach((b) => {
          const on = b === btn;
          b.classList.toggle('active', on);
          b.setAttribute('aria-pressed', String(on));
        });
      });
    });
  }
</script>

<style>
  .main-image {
    background: var(--paper);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    overflow: hidden;
    aspect-ratio: 1 / 1;
  }
  .main-image :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .thumbs {
    display: flex;
    gap: 10px;
    list-style: none;
    margin: 12px 0 0;
    padding: 0;
    flex-wrap: wrap;
  }
  .thumb {
    padding: 0;
    border: 2px solid transparent;
    border-radius: var(--radius);
    overflow: hidden;
    background: var(--white);
    cursor: pointer;
    width: 72px;
    height: 72px;
    line-height: 0;
  }
  .thumb :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .thumb.active,
  .thumb[aria-pressed='true'] {
    border-color: var(--teal);
  }
</style>
