---
/**
 * /products/ — every product on one page, grouped by category, with the
 * category guides one click away. The old 16-per-page split sent half the
 * range to /products/page/2/, which now 301s here.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from './Breadcrumbs.astro';
import ProductGrid from './ProductGrid.astro';
import QuoteSection from './QuoteSection.astro';
import FAQSection from './FAQSection.astro';
import { products, categories, productsInCategory } from '../lib/catalogue';
import { categoryMeta } from '../lib/category-content';
import { displayName } from '../lib/product-content';
import { absoluteUrl } from '../lib/site';
import { FACTS } from '../lib/facts';
import faqs from '../data/page-faqs/products.json';

const path = '/products/';
const crumbs = [{ label: 'Home', href: '/' }, { label: 'All stickers' }];
const title = 'All Custom Sticker Products: 29 Types Compared';
const description =
  'Every custom sticker we print on one page: vinyl, clear, holographic, metallic, paper, waterproof, reflective, glow, reusable, decals and labels. Any shape.';

const groups = categories.map((c) => ({ meta: categoryMeta(c.slug), items: productsInCategory(c.slug), href: `/product-category/${c.slug}/` }));
---

<BaseLayout
  title={title}
  description={description}
  path={path}
  schema={[
    {
      '@context': 'https://schema.org',
      '@type': 'BreadcrumbList',
      itemListElement: crumbs.map((c, i) => ({
        '@type': 'ListItem',
        position: i + 1,
        name: c.label,
        ...(c.href ? { item: absoluteUrl(c.href) } : {}),
      })),
    },
    {
      '@context': 'https://schema.org',
      '@type': 'CollectionPage',
      name: 'All custom sticker products',
      description,
      url: absoluteUrl(path),
      mainEntity: {
        '@type': 'ItemList',
        numberOfItems: products.length,
        itemListElement: products.map((p, i) => ({
          '@type': 'ListItem',
          position: i + 1,
          name: displayName(p),
          url: absoluteUrl(`/product/${p.slug}/`),
        })),
      },
    },
    {
      '@context': 'https://schema.org',
      '@type': 'FAQPage',
      mainEntity: faqs.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
  ]}
>
  <Breadcrumbs items={crumbs} />

  <section class="section-tight section-white arch-head">
    <div class="container">
      <h1>All Custom Sticker Products</h1>
      <p class="lead">
        Twenty-nine sticker, decal and label products, each printed to your artwork and cut to shape. They are
        grouped below by material, feature, size, type and use; the same product can appear in more than one
        way of browsing but has one page.
      </p>
      <p class="arch-facts">
        From {FACTS.unitPriceFromLabel} per sticker · Minimum {FACTS.minOrderLabel} · {FACTS.proof} ·
        {FACTS.shipping}
      </p>
      <nav class="jump-list" aria-label="Jump to a group">
        {groups.map((g) => <a href={`#${g.meta.slug}`}>{g.meta.navLabel}</a>)}
      </nav>
    </div>
  </section>

  {
    groups.map((g, i) => (
      <section class:list={['section-tight', i % 2 === 1 && 'section-white']} id={g.meta.slug} aria-labelledby={`${g.meta.slug}-h`}>
        <div class="container">
          <div class="group-head">
            <h2 id={`${g.meta.slug}-h`}>{g.meta.name}</h2>
            <p>
              {g.meta.tagline} <a href={g.href}>Read the {g.meta.navLabel.toLowerCase()} guide</a>.
            </p>
          </div>
          <ProductGrid products={g.items} eagerCount={i === 0 ? 3 : 0} />
        </div>
      </section>
    ))
  }

  <section class="section-tight section-white">
    <div class="container">
      <FAQSection faqs={faqs} heading="Choosing between the products" />
    </div>
  </section>

  <QuoteSection id="quote" />
</BaseLayout>

<style>
  .arch-head {
    border-bottom: 1px solid var(--line);
  }
  .arch-facts {
    color: var(--muted);
    font-size: 0.95rem;
    margin: 0 0 16px;
  }
  .jump-list {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .jump-list a {
    text-decoration: none;
    border: 1px solid var(--line-strong);
    border-radius: var(--radius);
    padding: 6px 12px;
    color: var(--ink);
    font-size: 0.92rem;
  }
  .jump-list a:hover {
    border-color: var(--teal);
    color: var(--teal-dark);
  }
  .group-head {
    display: flex;
    justify-content: space-between;
    align-items: end;
    gap: 24px;
    margin-bottom: 20px;
  }
  .group-head h2 {
    margin: 0;
    font-size: 1.5rem;
  }
  .group-head p {
    margin: 0;
    max-width: 56ch;
    color: var(--muted);
    font-size: 0.95rem;
  }
  @media (max-width: 760px) {
    .group-head {
      flex-direction: column;
      align-items: start;
      gap: 6px;
    }
  }
</style>
