---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from './Breadcrumbs.astro';
import ProductGrid from './ProductGrid.astro';
import CTASection from './CTASection.astro';
import { productsByName, categories, PRODUCTS_PER_PAGE } from '../lib/catalogue';
import { absoluteUrl } from '../lib/site';

interface Props {
  currentPage: number;
}
const { currentPage } = Astro.props;

/*
 * The published archive listed every product alphabetically, 16 per page, with
 * page two at /products/page/2/ — a live URL that carried rel="next". That
 * pagination shape is reproduced exactly so the URL is preserved.
 *
 * What is NOT reproduced is the Elementor block that opened the page with 29
 * burger-box products from an earlier site on this WordPress install, every one
 * of them linking to a URL that 404s. See reports/MIGRATION_CONFLICTS.md.
 */
const total = productsByName.length;
const lastPage = Math.ceil(total / PRODUCTS_PER_PAGE);
const start = (currentPage - 1) * PRODUCTS_PER_PAGE;
const items = productsByName.slice(start, start + PRODUCTS_PER_PAGE);

const pageUrl = (n: number) => (n === 1 ? '/products/' : `/products/page/${n}/`);
const path = pageUrl(currentPage);
const isFirst = currentPage === 1;

const crumbs = [{ label: 'Home', href: '/' }, { label: 'Products' }];

const title = isFirst
  ? 'All Sticker Products | The Die Cut Stickers'
  : `All Sticker Products — Page ${currentPage} | The Die Cut Stickers`;
const description = isFirst
  ? 'Browse every custom sticker we print: vinyl, clear, holographic, metallic, reflective, waterproof and eco-friendly options in any shape or size.'
  : `Page ${currentPage} of the full custom sticker range from The Die Cut Stickers, including vinyl, clear, holographic and waterproof options.`;
---

<BaseLayout
  title={title}
  description={description}
  path={path}
  prev={currentPage > 1 ? pageUrl(currentPage - 1) : undefined}
  next={currentPage < lastPage ? pageUrl(currentPage + 1) : undefined}
  schema={[
    {
      '@context': 'https://schema.org',
      '@type': 'BreadcrumbList',
      itemListElement: crumbs.map((c, i) => ({
        '@type': 'ListItem',
        position: i + 1,
        name: c.label,
        ...(c.href ? { item: absoluteUrl(c.href) } : {}),
      })),
    },
    {
      '@context': 'https://schema.org',
      '@type': 'CollectionPage',
      name: 'All Products',
      url: absoluteUrl(path),
      mainEntity: {
        '@type': 'ItemList',
        numberOfItems: total,
        itemListElement: items.map((p, i) => ({
          '@type': 'ListItem',
          position: start + i + 1,
          name: p.name,
          url: absoluteUrl(`/product/${p.slug}/`),
        })),
      },
    },
  ]}
>
  <Breadcrumbs items={crumbs} />

  <section class="section-tight">
    <div class="container">
      <h1>All Products</h1>
      {
        isFirst && (
          <p class="lede">
            Every sticker below is printed to your own artwork and cut to shape. Browse the
            full range, or jump to a category to compare materials, finishes and sizes.
          </p>
        )
      }
      <ul class="cat-links" role="list">
        {
          categories.map((c) => (
            <li>
              <a href={`/product-category/${c.slug}/`}>{c.name}</a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section-tight section-white" aria-labelledby="listing-heading">
    <div class="container">
      <h2 id="listing-heading" class="visually-hidden">Product listing</h2>
      <p class="count">
        Showing {start + 1}–{start + items.length} of {total} results
      </p>
      <ProductGrid products={items} eagerCount={3} showCategory />

      {
        lastPage > 1 && (
          <nav class="pagination" aria-label="Products pagination">
            <ul role="list">
              {Array.from({ length: lastPage }, (_, i) => i + 1).map((n) => (
                <li>
                  {n === currentPage ? (
                    <span aria-current="page">{n}</span>
                  ) : (
                    <a href={pageUrl(n)}>{n}</a>
                  )}
                </li>
              ))}
              {currentPage < lastPage && (
                <li>
                  <a class="next" href={pageUrl(currentPage + 1)}>
                    Next
                  </a>
                </li>
              )}
            </ul>
          </nav>
        )
      }
    </div>
  </section>

  <CTASection id="quote" />
</BaseLayout>

<style>
  .lede {
    max-width: 760px;
    font-size: 1.02rem;
  }
  .cat-links {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    list-style: none;
    margin: 18px 0 0;
    padding: 0;
  }
  .cat-links a {
    display: inline-block;
    padding: 8px 16px;
    border-radius: 999px;
    background: var(--tint);
    color: var(--blue);
    text-decoration: none;
    font-size: 0.9rem;
    font-weight: 600;
  }
  .cat-links a:hover {
    background: var(--purple);
    color: #fff;
  }
  .count {
    color: var(--muted);
    font-size: 0.9rem;
    margin-bottom: 20px;
  }
  .pagination {
    margin-top: 32px;
  }
  .pagination ul {
    display: flex;
    gap: 8px;
    list-style: none;
    margin: 0;
    padding: 0;
    justify-content: center;
    flex-wrap: wrap;
  }
  .pagination a,
  .pagination span {
    display: grid;
    place-items: center;
    min-width: 44px;
    min-height: 44px;
    padding: 0 14px;
    border-radius: 8px;
    text-decoration: none;
    font-weight: 600;
    font-size: 0.95rem;
  }
  .pagination a {
    background: var(--white);
    border: 1px solid var(--line);
    color: var(--ink);
  }
  .pagination a:hover {
    background: var(--purple);
    border-color: var(--purple);
    color: #fff;
  }
  .pagination [aria-current='page'] {
    background: var(--purple);
    color: #fff;
  }
</style>
