---
import { Image } from 'astro:assets';
import slide1 from '../assets/img/Glossy-Stickers-Packaging.jpg';
import slide2 from '../assets/img/Small-Custom-Stickers.jpg';
import slide3 from '../assets/img/Custom-Die-Cut-Labels.jpg';

/*
 * Rebuilt from the three Elementor slide templates supplied with the exports
 * (elementor-2722 "Slide 1", -2730 "Slide 2", -2736 "Slide 3"). Copy, button
 * labels and images are migrated verbatim.
 *
 * Slide one carried the <h1> in the source, so it provides the page heading.
 * Its button had no link in the export; it points at the on-page quote form,
 * which is the site's conversion path.
 *
 * Built with CSS scroll-snap rather than a carousel library: no third-party
 * JavaScript, it still works with JS disabled, and it is keyboard operable.
 */
const SLIDES = [
  {
    id: 1,
    heading: 'Custom Die Cut Stickers,<br />Made Just for You!',
    body: 'Precision cuts, vibrant prints, and endless possibilities for your brand, business, or personal projects.',
    cta: { label: 'Design Your Sticker Now', href: '#quote' },
    image: slide1,
    alt: 'Custom glossy die cut stickers with printed packaging',
  },
  {
    id: 2,
    heading: 'Fast Shipping, High-Quality Stickers',
    body: 'Get your custom stickers delivered right to your doorstep with best quality and durability.',
    cta: { label: 'Shop Now', href: '/products/' },
    image: slide2,
    alt: 'Small custom die cut stickers in assorted shapes',
  },
  {
    id: 3,
    heading: 'Stickers for Every Occasion',
    body: 'From business branding to personal flair, our custom die-cut stickers bring your ideas to life.',
    cta: { label: 'Explore Our Collection', href: '/products/' },
    image: slide3,
    alt: 'Custom die cut labels applied to product packaging',
  },
];
---

<section class="hero" aria-roledescription="carousel" aria-label="Featured sticker services">
  <div class="hero-track" id="hero-track" tabindex="0" aria-live="polite">
    {
      SLIDES.map((s, i) => (
        <article
          class="slide"
          id={`slide-${s.id}`}
          role="group"
          aria-roledescription="slide"
          aria-label={`${i + 1} of ${SLIDES.length}`}
        >
          <div class="slide-inner container">
            <div class="slide-copy">
              {i === 0 ? (
                <h1 set:html={s.heading} />
              ) : (
                <h2 set:html={s.heading} />
              )}
              <p>{s.body}</p>
              <a class="btn btn-primary" href={s.cta.href}>
                {s.cta.label}
              </a>
            </div>
            <div class="slide-media">
              <Image
                src={s.image}
                alt={s.alt}
                widths={[360, 520, 720]}
                sizes="(max-width: 860px) 84vw, 420px"
                loading={i === 0 ? 'eager' : 'lazy'}
                fetchpriority={i === 0 ? 'high' : 'auto'}
                decoding={i === 0 ? 'sync' : 'async'}
              />
            </div>
          </div>
        </article>
      ))
    }
  </div>

  <button type="button" class="nav prev" id="hero-prev" aria-controls="hero-track">
    <span aria-hidden="true">‹</span><span class="visually-hidden">Previous slide</span>
  </button>
  <button type="button" class="nav next" id="hero-next" aria-controls="hero-track">
    <span aria-hidden="true">›</span><span class="visually-hidden">Next slide</span>
  </button>

  <div class="hero-controls">
    <div class="dots" role="tablist" aria-label="Choose slide">
      {
        SLIDES.map((s, i) => (
          <button
            type="button"
            class="dot"
            role="tab"
            data-index={i}
            aria-controls={`slide-${s.id}`}
            aria-selected={i === 0 ? 'true' : 'false'}
          >
            <span class="visually-hidden">Slide {i + 1}</span>
          </button>
        ))
      }
    </div>
    {/* WCAG 2.2.2: anything that moves for more than five seconds needs a pause control. */}
    <button type="button" class="playpause" id="hero-playpause" aria-pressed="false">
      <span class="icon" aria-hidden="true">❚❚</span>
      <span class="label">Pause</span>
    </button>
  </div>
</section>

<style>
  .hero {
    position: relative;
    background: linear-gradient(135deg, var(--tint) 0%, var(--tint-2) 100%);
    overflow: hidden;
  }

  .hero-track {
    display: flex;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    scrollbar-width: none;
  }
  .hero-track::-webkit-scrollbar {
    display: none;
  }
  .hero-track:focus-visible {
    outline: 3px solid var(--purple);
    outline-offset: -3px;
  }

  .slide {
    flex: 0 0 100%;
    scroll-snap-align: start;
    min-width: 0;
  }
  .slide-inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 0.85fr);
    align-items: center;
    gap: 40px;
    padding-block: clamp(32px, 3vw, 60px);
    min-height: 380px;
  }

  .slide-copy :global(h1),
  .slide-copy :global(h2) {
    margin: 0 0 14px;
    font-size: clamp(1.7rem, 1.2rem + 2.2vw, 2.7rem);
    line-height: 1.2;
  }
  .slide-copy p {
    margin: 0 0 22px;
    font-size: 1.03rem;
    max-width: 46ch;
  }

  .slide-media {
    line-height: 0;
  }
  .slide-media :global(img) {
    width: 100%;
    height: auto;
    max-width: 420px;
    margin-inline: auto;
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow);
  }

  /* ------------------------------------------------------------- controls */
  .nav {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    width: 44px;
    height: 44px;
    border: 0;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.92);
    box-shadow: var(--shadow-sm);
    color: var(--ink);
    font-size: 1.6rem;
    line-height: 1;
    cursor: pointer;
    display: grid;
    place-items: center;
  }
  .nav:hover {
    background: #fff;
    color: var(--purple-dark);
  }
  .prev {
    left: 10px;
  }
  .next {
    right: 10px;
  }

  .hero-controls {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 18px;
    padding-bottom: 16px;
  }
  .dots {
    display: flex;
    gap: 8px;
  }
  .dot {
    width: 28px;
    height: 28px;
    padding: 0;
    border: 0;
    background: transparent;
    cursor: pointer;
    display: grid;
    place-items: center;
  }
  .dot::before {
    content: '';
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: #b9c2d0;
    transition: background-color 0.2s ease, transform 0.2s ease;
  }
  .dot[aria-selected='true']::before {
    background: var(--purple);
    transform: scale(1.35);
  }

  .playpause {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    min-height: 28px;
    padding: 4px 10px;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.9);
    color: var(--muted);
    font: inherit;
    font-size: 0.75rem;
    cursor: pointer;
  }
  .playpause:hover {
    color: var(--ink);
  }
  .playpause .icon {
    font-size: 0.7rem;
  }

  @media (max-width: 860px) {
    .slide-inner {
      grid-template-columns: minmax(0, 1fr);
      gap: 24px;
      text-align: center;
      min-height: 0;
    }
    .slide-copy p {
      margin-inline: auto;
    }
    .slide-media :global(img) {
      max-width: 320px;
    }
    .nav {
      display: none;
    }
  }
</style>

<script>
  const track = document.getElementById('hero-track');
  const prev = document.getElementById('hero-prev');
  const next = document.getElementById('hero-next');
  const playpause = document.getElementById('hero-playpause');

  if (track && prev && next && playpause) {
    const slides = Array.from(track.querySelectorAll<HTMLElement>('.slide'));
    const dots = Array.from(document.querySelectorAll<HTMLButtonElement>('.dot'));
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)');

    let index = 0;
    let timer: number | undefined;

    const go = (i: number) => {
      index = (i + slides.length) % slides.length;
      track.scrollTo({
        left: slides[index].offsetLeft - track.offsetLeft,
        behavior: reduced.matches ? 'auto' : 'smooth',
      });
      dots.forEach((d, n) => d.setAttribute('aria-selected', String(n === index)));
    };

    const stop = () => {
      if (timer !== undefined) window.clearInterval(timer);
      timer = undefined;
      playpause.setAttribute('aria-pressed', 'true');
      playpause.querySelector('.icon')!.textContent = '▶';
      playpause.querySelector('.label')!.textContent = 'Play';
    };

    const start = () => {
      if (reduced.matches || timer !== undefined) return;
      timer = window.setInterval(() => go(index + 1), 6000);
      playpause.setAttribute('aria-pressed', 'false');
      playpause.querySelector('.icon')!.textContent = '❚❚';
      playpause.querySelector('.label')!.textContent = 'Pause';
    };

    prev.addEventListener('click', () => { stop(); go(index - 1); });
    next.addEventListener('click', () => { stop(); go(index + 1); });
    dots.forEach((d, n) => d.addEventListener('click', () => { stop(); go(n); }));

    playpause.addEventListener('click', () => (timer === undefined ? start() : stop()));

    track.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowRight') { e.preventDefault(); stop(); go(index + 1); }
      if (e.key === 'ArrowLeft') { e.preventDefault(); stop(); go(index - 1); }
    });

    // Keep the dots honest when the track is swiped or scrolled directly.
    let raf = 0;
    track.addEventListener('scroll', () => {
      cancelAnimationFrame(raf);
      raf = requestAnimationFrame(() => {
        const n = Math.round(track.scrollLeft / track.clientWidth);
        if (n !== index && slides[n]) {
          index = n;
          dots.forEach((d, i) => d.setAttribute('aria-selected', String(i === index)));
        }
      });
    });

    // Autoplay only while the hero is on screen, and never under reduced motion.
    const io = new IntersectionObserver(
      ([entry]) => (entry.isIntersecting ? start() : stop()),
      { threshold: 0.4 },
    );
    io.observe(track);

    track.addEventListener('mouseenter', stop);
    track.addEventListener('focusin', stop);
    reduced.addEventListener('change', () => reduced.matches && stop());
  }
</script>
