---
import type { Faq } from '../lib/catalogue';

interface Props {
  faqs: Faq[];
  heading?: string;
  intro?: string;
  id?: string;
}
const { faqs, heading = 'Frequently asked questions', intro, id = 'faqs' } = Astro.props;
---

{
  faqs.length > 0 && (
    <section class="faq-block" id={id} aria-labelledby={`${id}-heading`}>
      <div class="faq-head">
        <h2 id={`${id}-heading`}>{heading}</h2>
        {intro && <p>{intro}</p>}
      </div>
      <div class="faqs">
        {faqs.map((f, i) => (
          <details class="faq" open={i === 0}>
            <summary>
              <span>{f.q}</span>
              <span class="chev" aria-hidden="true" />
            </summary>
            <div class="answer">
              <p>{f.a}</p>
            </div>
          </details>
        ))}
      </div>
    </section>
  )
}

<style>
  .faq-head {
    max-width: 720px;
    margin-bottom: 1.4rem;
  }
  .faq-head p {
    color: var(--muted);
    margin: 0;
  }
  .faqs {
    border-top: 1px solid var(--line);
  }
  .faq {
    border-bottom: 1px solid var(--line);
  }
  summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 16px 2px;
    cursor: pointer;
    font-weight: 600;
    font-size: 1.05rem;
    color: var(--ink);
    list-style: none;
    min-height: 44px;
  }
  summary::-webkit-details-marker {
    display: none;
  }
  summary:hover {
    color: var(--teal-dark);
  }
  .chev {
    flex: 0 0 auto;
    width: 9px;
    height: 9px;
    border-right: 2px solid var(--muted);
    border-bottom: 2px solid var(--muted);
    transform: rotate(45deg);
    transition: transform 0.15s ease;
    margin-right: 4px;
  }
  details[open] .chev {
    transform: rotate(-135deg);
  }
  .answer {
    padding: 0 2px 18px;
    max-width: 76ch;
  }
  .answer p {
    margin: 0;
  }
</style>
