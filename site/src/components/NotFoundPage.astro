---
/**
 * The 404 body, shared by the prerendered /404 page and the on-demand
 * root-level catch-all in src/pages/[slug].astro.
 *
 * Deliberately does NOT set Astro.response.status: prerendered pages ignore it
 * and Astro warns when it is set there. Each caller owns its own status code.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import { categories } from '../lib/catalogue';
---

<BaseLayout
  title="Page not found | The Die Cut Stickers"
  description="The page you asked for does not exist. Browse our custom sticker range instead."
  path="/404/"
  noindex
>
  <section class="section">
    <div class="container narrow">
      <p class="code">404</p>
      <h1>We couldn't find that page</h1>
      <p>
        The page you asked for is not here. It may have been removed, or the address may be
        mistyped.
      </p>
      <p>
        <a class="btn btn-primary" href="/products/">Browse all stickers</a>
      </p>
      <h2>Sticker categories</h2>
      <ul class="cats" role="list">
        {
          categories.map((c) => (
            <li>
              <a href={`/product-category/${c.slug}/`}>{c.name}</a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</BaseLayout>

<style>
  .narrow {
    max-width: 720px;
  }
  .code {
    font-size: 3.4rem;
    font-weight: 800;
    color: var(--purple);
    margin: 0;
    line-height: 1;
  }
  .cats {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    list-style: none;
    padding: 0;
  }
  .cats a {
    display: inline-block;
    padding: 8px 16px;
    border-radius: 999px;
    background: var(--tint);
    text-decoration: none;
    font-weight: 600;
    font-size: 0.9rem;
  }
</style>
