---
import { Image } from 'astro:assets';
import type { Product } from '../lib/catalogue';
import { resolveImage, productAlt } from '../lib/images';
import { displayName, productContent } from '../lib/product-content';
import { FACTS } from '../lib/facts';

interface Props {
  product: Product;
  eager?: boolean;
  showCategory?: boolean;
}
const { product, eager = false, showCategory = false } = Astro.props;
const img = resolveImage(product.images[0] ?? '');
const name = displayName(product);
const rewrite = productContent(product.slug);
const blurb = rewrite?.tagline ?? '';
const price = Number(product.price) || FACTS.unitPriceFrom;
---

<article class="card product-card">
  <a class="card-link" href={`/product/${product.slug}/`}>
    <div class="thumb">
      {
        img ? (
          <Image
            src={img}
            alt={productAlt(name, 0, product.images.length)}
            widths={[300, 420, 600]}
            sizes="(max-width: 560px) 46vw, (max-width: 960px) 31vw, 300px"
            loading={eager ? 'eager' : 'lazy'}
            decoding={eager ? 'sync' : 'async'}
          />
        ) : (
          <span class="placeholder" aria-hidden="true">The Die Cut Stickers</span>
        )
      }
    </div>
    <div class="meta">
      {showCategory && <p class="cat">{product.category}</p>}
      <h3 class="name">{name}</h3>
      {blurb && <p class="blurb">{blurb}</p>}
      <p class="price">
        From <strong>${price.toFixed(2)}</strong> per sticker
      </p>
    </div>
  </a>
</article>

<style>
  .product-card {
    overflow: hidden;
    height: 100%;
    transition: border-color 0.15s ease, box-shadow 0.15s ease, transform 0.15s ease;
  }
  .product-card:hover {
    border-color: var(--line-strong);
    box-shadow: var(--shadow);
    transform: translateY(-2px);
  }
  .card-link {
    display: flex;
    flex-direction: column;
    height: 100%;
    text-decoration: none;
    color: inherit;
  }
  .thumb {
    aspect-ratio: 1 / 1;
    background: var(--paper);
    overflow: hidden;
    border-bottom: 1px solid var(--line);
  }
  .thumb :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.3s ease;
  }
  .product-card:hover .thumb :global(img) {
    transform: scale(1.03);
  }
  .placeholder {
    display: grid;
    place-items: center;
    height: 100%;
    font-size: 0.8rem;
    color: var(--muted);
  }
  .meta {
    padding: 14px 16px 16px;
    display: flex;
    flex-direction: column;
    gap: 4px;
    flex: 1;
  }
  .cat {
    margin: 0;
    font-size: 0.78rem;
    color: var(--muted);
  }
  .name {
    margin: 0;
    font-family: var(--font);
    font-size: 1.05rem;
    font-weight: 700;
    color: var(--ink);
    line-height: 1.3;
  }
  .card-link:hover .name {
    color: var(--teal-dark);
  }
  .blurb {
    margin: 0;
    font-size: 0.9rem;
    color: var(--muted);
    line-height: 1.45;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .price {
    margin: auto 0 0;
    padding-top: 8px;
    font-size: 0.92rem;
    color: var(--muted);
  }
  .price strong {
    color: var(--ink);
  }
</style>
